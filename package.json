{
  "name": "ietc-electron-todolist",
  "version": "1.0.0",
  "description": "",
  "main": ".vite/build/main.js",
  "scripts": {
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:renderer": "cd src/renderer && npx ng build --base-href ./",
    "start": "npm run build:main && npm run build:preload && npm run build:renderer && electron .",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:studio": "npx prisma studio",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "dotenv": "^17.4.2",
    "electron": "^41.1.1",
    "prisma": "^7.8.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.9.0"
  }
}
